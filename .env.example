# Variables de entorno de la Herramienta Lasarte — inventario COMPLETO (02-09-2026).
#
# Tres sitios distintos leen variables, y ninguno ve las de los otros:
#   1. La APP (Vite/React, Vercel): solo las VITE_*. Viajan en el bundle: nada secreto.
#   2. Los SCRIPTS del portátil de la oficina (Node, tareas programadas): leen este
#      fichero .env con process.loadEnvFile. Aquí SÍ hay secretos (service role).
#   3. Las EDGE FUNCTIONS (Deno, Supabase): leen los SECRETOS del proyecto
#      (`supabase secrets set`), no este fichero. Se listan abajo para que el
#      runbook de recuperación sepa qué hay que volver a poner.
#
# Copia este fichero a .env (que está en .gitignore) y rellena lo que aplique.
# Los valores reales viven en el gestor de contraseñas; nunca en el repo.

# ─── 1. APP (Vercel) ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon key>"                # pública: viaja en el bundle
# Solo informativas (ningún código de src/ las lee hoy):
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key>"

# ─── 2. SCRIPTS DEL PORTÁTIL (scripts/*.mjs, tareas programadas) ─────────────
# Supabase con clave de servicio: escriben tablas, storage y latidos.
SUPABASE_URL="https://<project-ref>.supabase.co"     # los scripts aceptan también VITE_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY="<service role key>"       # SECRETO. Sincroniza a OneDrive con el .env: cuidado.

# Correo (Resend) del aviso diario y del correo de rendimiento.
RESEND_API_KEY="<resend api key>"
RESEND_FROM_TECNICO="Herramienta Lasarte <aviso@comunicaciones.lasartesat.com>"
AVISO_DESTINO="soporte@lasartesat.es"               # aviso-diario-erp.mjs (07:10); varios separados por coma
INFORME_DIARIO_PARA="soporte@lasartesat.es"         # informe-produccion/correo-diario.mjs (09:00)

# Buzón Gmail que recibe los informes del Sizer (leer-buzon-correo.mjs, cada 30 min).
BUZON_IMAP_HOST="imap.gmail.com"
BUZON_IMAP_PUERTO="993"
BUZON_IMAP_USUARIO="lasartecitricos@gmail.com"
BUZON_IMAP_PASSWORD="<contraseña de aplicación>"    # SECRETO
BUZON_IMAP_CARPETA="INBOX"
BUZON_REMITENTES="lasartecitricos@gmail.com"        # remitentes admitidos, separados por coma

# Base SQL Server del calibrador Compac (SizerResults), solo lectura y con permiso.
# Sin SIZER_USUARIO/SIZER_PASSWORD no funciona el catálogo de productos del Sizer
# (pendiente en docs/SISTEMA_LASARTE.md §8).
SIZER_HOST="192.168.1.209"
SIZER_INSTANCIA="<instancia>"
SIZER_PUERTO="1433"
SIZER_BD="SizerResults"
SIZER_USUARIO="<usuario>"
SIZER_PASSWORD="<contraseña>"                        # SECRETO

# El ERP (MySQL 192.168.1.10) NO se configura aquí: las credenciales se leen del
# registro de Windows del portátil (HKCU\Software\LRInformatica). Ver docs/ERP_LR_INFORMATICA.md.

# ─── 3. SECRETOS DE LAS EDGE FUNCTIONS (Supabase → Project Settings → Edge Functions) ──
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY los inyecta Supabase solo.
# Correo saliente (Resend), un remitente por familia de correo:
#   RESEND_API_KEY
#   RESEND_FROM                 remitente por defecto
#   RESEND_FROM_INFORME         informe semanal / ventas Mercadona / cierre mensual
#   RESEND_FROM_RRHH            comunicaciones a trabajadores (enviar-comunicacion)
#   RESEND_FROM_VIGILANTE       vigilante
#   RESEND_FROM_VIGIA           vigía de negocio
#   EMAIL_REPLY_TO, EMAIL_REPLY_TO_INFORME, EMAIL_LOGO_URL, APP_URL
# Destinatarios (separados por coma; si faltan, soporte@lasartesat.es):
#   INFORME_SEMANAL_PARA        lunes 12:00
#   VENTAS_MERCADONA_PARA       lunes 10:00
#   VIGILANTE_PARA              13:45 (solo cuando algo no late)
#   VIGIA_PARA                  14:15 (lleva euros: solo admin)
#   CIERRE_MENSUAL_PARA         día 1
# IA (todas opcionales; la cadena degrada al siguiente proveedor):
#   OPENROUTER_API_KEY, OPENROUTER_VISION_MODEL, OPENCODE_API_KEY, PUTER_AUTH_TOKEN,
#   MISTRAL_API_KEY, MISTRAL_OCR_MODEL (OCR de partes), GEMINI_API_KEY, GROQ_API_KEY,
#   NVIDIA_API_KEY, DEEPSEEK_API_KEY
# Brevo (correo a productores desde enviar-comunicacion, alternativa a Resend):
#   BREVO_API_KEY, BREVO_FROM_EMAIL, BREVO_FROM_NAME
